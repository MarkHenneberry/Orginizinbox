generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailProviderName {
  gmail
  microsoft
}

enum ScanStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum CleanupJobStatus {
  pending
  running
  completed
  failed
  cancelled
  partial
}

enum EntitlementPlan {
  free_scan
  full_inbox_reset
}

model User {
  id                  String               @id @default(cuid())
  emailHash           String?              @unique
  microsoftIdentityHash String?            @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  providerConnections ProviderConnection[]
  scans               Scan[]
  purchases           Purchase[]
  cleanupJobStates    CleanupJobState[]
  scanStates          ScanState[]
  billingAccount      BillingAccount?
  creditOwnerId       String?
  creditOwner         User? @relation("CreditMembership", fields: [creditOwnerId], references: [id], onDelete: Restrict)
  linkedCreditUsers   User[] @relation("CreditMembership")
  @@index([creditOwnerId])
}

model ProviderConnection {
  id                    String            @id @default(cuid())
  userId                String
  provider              EmailProviderName
  mailboxExternalIdHash String?
  encryptedAccountEmail  String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scope                 String?
  encryptedImapAccessToken  String?
  encryptedImapRefreshToken String?
  imapTokenExpiresAt        DateTime?
  imapScope                 String?
  tokenVersion          Int               @default(0)
  sessionGeneration     String?
  refreshLeaseOwner     String?
  refreshLeaseExpiresAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  disconnectedAt        DateTime?
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans                 Scan[]
  scanStates            ScanState[]
  requestLeases         ProviderRequestLease[]

  @@unique([userId, provider])
}

model Scan {
  id                   String              @id @default(cuid())
  userId               String
  providerConnectionId String
  provider             EmailProviderName
  status               ScanStatus          @default(pending)
  failureCode          String?
  failureMessage       String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection  @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  cleanupJobs          CleanupJob[]
  transientState       ScanState?

  @@index([userId, status])
}

model ScanState {
  userId               String
  provider             EmailProviderName
  scanId               String            @unique
  providerConnectionId String
  status               ScanStatus         @default(pending)
  encryptedPayload     String             @db.Text
  version              Int                @default(1)
  lockOwner            String?
  lockExpiresAt        DateTime?
  expiresAt            DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan                  Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  providerConnection    ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@index([expiresAt])
}

model CleanupJob {
  id             String           @id @default(cuid())
  scanId         String
  acceptanceKey  String?
  status         CleanupJobStatus @default(pending)
  failureCode    String?
  failureMessage String?
  terminalState  String?
  terminalSnapshot Json?
  terminalSnapshotVersion Int @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  scan           Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  transientState CleanupJobState?

  @@index([scanId, status])
  @@unique([scanId, acceptanceKey])
}

model ProviderRequestLease {
  providerConnectionId String
  slot                  Int
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  providerConnection    ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@id([providerConnectionId, slot])
  @@index([leaseExpiresAt])
}

model CleanupJobState {
  jobId            String   @id
  userId           String
  encryptedPayload String   @db.Text
  version          Int      @default(1)
  lockOwner        String?
  lockExpiresAt    DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  job              CleanupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditAccounting CreditJobAccounting?

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Purchase {
  id              String          @id @default(cuid())
  userId          String
  provider        EmailProviderName?
  plan            EntitlementPlan
  stripeReference String?         @unique
  amountCents     Int
  currency        String          @default("usd")
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingAccount {
  userId               String   @id
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  subscriptionStatus  String   @default("free")
  latestInvoicePaid    Boolean  @default(false)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  livemode            Boolean  @default(false)
  syncedAt            DateTime?
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  checkoutAttemptKey  String?
  checkoutAttemptedAt DateTime?
  checkoutPriceId     String?
  checkoutSessionId   String?
  checkoutExpiresAt   DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookReceipts     StripeWebhookReceipt[]
  creditBalance       Int @default(0)
  creditVersion       Int @default(0)
  creditPurchases     CreditPurchase[]
  creditJobs          CreditJobAccounting[]
  creditEntries       CreditEntry[]
}

// Financial records contain application identifiers and aggregate amounts only.
model CreditPurchase {
  id                String @id @default(cuid())
  userId            String
  pack              String
  stripePriceId     String
  stripeSessionId   String? @unique
  stripePaymentId   String? @unique
  credits           Int
  amountCents       Int
  granted           Int @default(0)
  reversed          Int @default(0)
  livemode          Boolean
  status            String @default("pending")
  expiresAt         DateTime
  checkedAt         DateTime?
  createdAt         DateTime @default(now())
  account           BillingAccount @relation(fields: [userId], references: [userId], onDelete: Restrict)
  @@index([userId, status])
}

model CreditJobAccounting {
  jobId             String @id
  userId            String
  activeStateJobId  String? @unique
  requested         Int
  moved             Int @default(0)
  restored          Int @default(0)
  closed            Boolean @default(false)
  activeState       CleanupJobState? @relation(fields: [activeStateJobId], references: [jobId], onDelete: SetNull)
  account           BillingAccount @relation(fields: [userId], references: [userId], onDelete: Restrict)
  @@index([userId, closed])
}

model CreditEntry {
  key       String @id
  userId    String
  amount    Int
  kind      String
  createdAt DateTime @default(now())
  account   BillingAccount @relation(fields: [userId], references: [userId], onDelete: Restrict)
  @@index([userId, createdAt])
}

model InboxLinkIntent {
  id                   String @id
  sourceUserId         String
  sourceConnectionId   String
  sourceGeneration     String
  provider             EmailProviderName
  expiresAt            DateTime
  consumedAt           DateTime?
  @@index([expiresAt])
}

model StripeWebhookReceipt {
  eventId     String   @id
  userId      String
  eventType   String
  livemode    Boolean
  processedAt DateTime @default(now())
  account     BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
}
