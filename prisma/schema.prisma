generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailProviderName {
  gmail
  microsoft
}

enum ScanStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum CleanupJobStatus {
  pending
  running
  completed
  failed
  cancelled
  partial
}

enum EntitlementPlan {
  free_scan
  full_inbox_reset
}

model User {
  id                  String               @id @default(cuid())
  emailHash           String?              @unique
  microsoftIdentityHash String?            @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  providerConnections ProviderConnection[]
  scans               Scan[]
  purchases           Purchase[]
  cleanupJobStates    CleanupJobState[]
  scanStates          ScanState[]
}

model ProviderConnection {
  id                    String            @id @default(cuid())
  userId                String
  provider              EmailProviderName
  mailboxExternalIdHash String?
  encryptedAccountEmail  String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scope                 String?
  encryptedImapAccessToken  String?
  encryptedImapRefreshToken String?
  imapTokenExpiresAt        DateTime?
  imapScope                 String?
  tokenVersion          Int               @default(0)
  sessionGeneration     String?
  refreshLeaseOwner     String?
  refreshLeaseExpiresAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  disconnectedAt        DateTime?
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans                 Scan[]
  scanStates            ScanState[]
  requestLeases         ProviderRequestLease[]

  @@unique([userId, provider])
}

model Scan {
  id                   String              @id @default(cuid())
  userId               String
  providerConnectionId String
  provider             EmailProviderName
  status               ScanStatus          @default(pending)
  failureCode          String?
  failureMessage       String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerConnection   ProviderConnection  @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  cleanupJobs          CleanupJob[]
  transientState       ScanState?

  @@index([userId, status])
}

model ScanState {
  userId               String
  provider             EmailProviderName
  scanId               String            @unique
  providerConnectionId String
  status               ScanStatus         @default(pending)
  encryptedPayload     String             @db.Text
  version              Int                @default(1)
  lockOwner            String?
  lockExpiresAt        DateTime?
  expiresAt            DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan                  Scan               @relation(fields: [scanId], references: [id], onDelete: Cascade)
  providerConnection    ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@id([userId, provider])
  @@index([expiresAt])
}

model CleanupJob {
  id             String           @id @default(cuid())
  scanId         String
  acceptanceKey  String?
  status         CleanupJobStatus @default(pending)
  failureCode    String?
  failureMessage String?
  terminalState  String?
  terminalSnapshot Json?
  terminalSnapshotVersion Int @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  scan           Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  transientState CleanupJobState?

  @@index([scanId, status])
  @@unique([scanId, acceptanceKey])
}

model ProviderRequestLease {
  providerConnectionId String
  slot                  Int
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  providerConnection    ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@id([providerConnectionId, slot])
  @@index([leaseExpiresAt])
}

model CleanupJobState {
  jobId            String   @id
  userId           String
  encryptedPayload String   @db.Text
  version          Int      @default(1)
  lockOwner        String?
  lockExpiresAt    DateTime?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  job              CleanupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Purchase {
  id              String          @id @default(cuid())
  userId          String
  provider        EmailProviderName?
  plan            EntitlementPlan
  stripeReference String?         @unique
  amountCents     Int
  currency        String          @default("usd")
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
