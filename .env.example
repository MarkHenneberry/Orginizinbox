# Public application URL used for canonical URLs and OAuth redirects.
NEXT_PUBLIC_APP_URL="https://organizinbox.com"

# Set to "true" to allow local fixture Inbox Report without provider credentials.
ORGANIZINBOX_FIXTURE_MODE="true"

# PostgreSQL-compatible database URL for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/organizinbox"

# Required before persisting OAuth tokens. Must be 32 bytes of key material encoded for your deployment.
TOKEN_ENCRYPTION_KEY=""

# Development-only Gmail benchmark gate. Keep false outside local development.
GMAIL_BENCHMARK_ENABLED="false"

# Development-only Gmail cleanup gate. Keep false outside local development.
GMAIL_CLEANUP_ENABLED="false"
GMAIL_CLEANUP_MAX_MESSAGES="100"
# Bounded Gmail metadata/label request concurrency for local cleanup validation.
GMAIL_CLEANUP_RECHECK_CONCURRENCY="8"

# Google OAuth for Gmail IMAP/XOAUTH2. Do not commit real values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
GMAIL_IMAP_HOST="imap.gmail.com"
GMAIL_IMAP_PORT="993"

# Microsoft identity / Graph OAuth. Do not commit real values.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/oauth/microsoft/callback"
MICROSOFT_OAUTH_DEV_ENABLED="false"

# Stripe checkout boundary. Do not commit real values.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FULL_RESET_USD=""
