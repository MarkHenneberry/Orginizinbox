# Public application URL used for canonical URLs and OAuth redirects.
NEXT_PUBLIC_APP_URL="https://organizinbox.com"

# Set to "true" to allow local fixture Inbox Report without provider credentials.
ORGANIZINBOX_FIXTURE_MODE="true"

# PostgreSQL-compatible database URL for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/organizinbox"

# Required before persisting OAuth tokens. Must be 32 bytes of key material encoded for your deployment.
TOKEN_ENCRYPTION_KEY=""

# Development-only Gmail benchmark gate. Keep false outside local development.
GMAIL_BENCHMARK_ENABLED="false"

# Development-only Gmail cleanup gate. Keep false outside local development.
GMAIL_CLEANUP_ENABLED="false"
GMAIL_CLEANUP_MAX_MESSAGES="100"
# Bounded Gmail metadata/label request concurrency for local cleanup validation.
GMAIL_CLEANUP_RECHECK_CONCURRENCY="8"
GMAIL_BULK_UNDO_PROOF_ENABLED="false"
GMAIL_BULK_UNDO_HISTORY_SHADOW_ENABLED="false"
GMAIL_HISTORY_SHADOW_PROOF_ENABLED="false"
# Development-only 250-message scalable job runner. Rejected in production.
GMAIL_SCALABLE_CLEANUP_DEV_ENABLED="false"
# Temporary development-only exact Trash post-state audit for scalable cleanup. Rejected in production.
GMAIL_SCALABLE_POSTSTATE_AUDIT_ENABLED="false"
# Durable orchestration remains disabled until production scalable cleanup is explicitly exposed.
GMAIL_SCALABLE_WORKFLOW_ENABLED="false"
# Development-only durable Workflow fixture provider. Requires fixture mode and never calls Gmail.
GMAIL_SCALABLE_WORKFLOW_FIXTURE_ENABLED="false"
# Normal local development uses memory. Production durable workflows use the existing Prisma/Postgres database.
GMAIL_SCALABLE_STORE_ADAPTER="memory"
# Authenticated-encryption key for transient cleanup state. Exactly 32 bytes as base64 or 32-byte UTF-8 material.
CLEANUP_STATE_ENCRYPTION_KEY=""
CLEANUP_STATE_ACTIVE_TTL_SECONDS="1800"
CLEANUP_STATE_UNDO_TTL_SECONDS="1800"
CLEANUP_STATE_TERMINAL_TTL_SECONDS="60"
CLEANUP_STATE_LOCK_TTL_SECONDS="60"

# Google OAuth for Gmail IMAP/XOAUTH2. Do not commit real values.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
GMAIL_IMAP_HOST="imap.gmail.com"
GMAIL_IMAP_PORT="993"

# Microsoft identity / Graph OAuth. Do not commit real values.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/oauth/microsoft/callback"
MICROSOFT_OAUTH_DEV_ENABLED="false"

# Stripe checkout boundary. Do not commit real values.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FULL_RESET_USD=""
